{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DobiShredder/MolShredder/blob/master/docs/schemas/result-envelope-v2.schema.json",
  "title": "MolShredder result envelope v2",
  "oneOf": [
    { "$ref": "#/$defs/success" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "scalar": {
      "anyOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "integer" },
        { "type": "number" },
        { "type": "string" }
      ]
    },
    "value": {
      "anyOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "integer" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/value" } },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/value" }
        }
      ]
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns", "rows"],
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "$ref": "#/$defs/scalar" }
          }
        }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "status", "command", "summary", "data"],
      "properties": {
        "schema_version": { "const": 2 },
        "status": { "const": "ok" },
        "command": { "type": "string" },
        "summary": { "type": "string" },
        "data": {
          "type": "object",
          "properties": { "table": { "$ref": "#/$defs/table" } },
          "additionalProperties": { "$ref": "#/$defs/value" }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "status", "command", "error"],
      "properties": {
        "schema_version": { "const": 2 },
        "status": { "const": "error" },
        "command": { "type": "string" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "suggestion", "details"],
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" },
            "suggestion": { "type": "string" },
            "details": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
